&lt;td style="text-align: left"&gt;&lt;strong&gt;메인 코스&lt;/strong&gt;&lt;/td&gt;
&lt;td style="text-align: left"&gt;평영 (Breaststroke)&lt;/td&gt;
&lt;td style="text-align: left"&gt;50m&lt;/td&gt;
&lt;td style="text-align: left"&gt;x 4&lt;/td&gt;
&lt;td style="text-align: left"&gt;200m&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;&lt;strong&gt;합계&lt;/strong&gt;&lt;/td&gt;
