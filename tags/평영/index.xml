&lt;td style="text-align: left"&gt;자유형 (Freestyle)&lt;/td&gt;
&lt;td style="text-align: left"&gt;400m&lt;/td&gt;
&lt;td style="text-align: left"&gt;x 1&lt;/td&gt;
&lt;td style="text-align: left"&gt;400m&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;&lt;strong&gt;지상 훈련&lt;/strong&gt;&lt;/td&gt;
