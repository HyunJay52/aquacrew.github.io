&lt;tr&gt;
&lt;td style="text-align: left"&gt;&lt;strong&gt;배영 드릴&lt;/strong&gt;&lt;/td&gt;
&lt;td style="text-align: left"&gt;핀 신고 배영 세션&lt;/td&gt;
&lt;td style="text-align: left"&gt;숏핀&lt;/td&gt;
&lt;td style="text-align: left"&gt;100m×1 / 50m×4 / 35m×4&lt;/td&gt;
&lt;td style="text-align: left"&gt;440m&lt;/td&gt;
&lt;td style="text-align: left"&gt;리커버리 각도 &amp;amp; 손목 누르기 교정&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;&lt;strong&gt;스타트&lt;/strong&gt;&lt;/td&gt;
